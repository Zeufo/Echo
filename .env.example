# Copy to .env and adjust if needed:  cp .env.example .env

# --- PostgreSQL ---
# DB_HOST/DB_PORT are used only when the app runs outside Docker.
# Inside Docker Compose these are overridden by the service name "db".
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=my_database
DB_HOST=localhost
DB_PORT=5433

# --- Redis / RabbitMQ ---
# Host URLs, for running the app outside Docker; inside Compose they point to the service names.
REDIS_URL=redis://localhost:6380/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Credentials used to create the RabbitMQ user in docker-compose.yml
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- API ---
# Number of uvicorn workers. 2 gives noticeably higher throughput than 1 (see README).
API_WORKERS=2
API_HOST_PORT=8000

# --- Published host ports ---
# Change these if the ports are already taken by local services.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
