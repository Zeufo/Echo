DB_USER=postgres
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_database

REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Только для docker compose (используются в docker-compose.yml)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Порты, публикуемые на хост (слева). Меняй, если заняты локальными сервисами.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
